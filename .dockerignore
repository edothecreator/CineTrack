# =============================================================================
#  .dockerignore — keep the build context lean
# =============================================================================

# Version control
.git
.gitignore

# Dependencies (re-installed inside the image)
node_modules

# Next.js build output (rebuilt inside the image)
.next
out

# Local env files — NEVER bake secrets into the image
.env
.env.*
!.env.example

# Dev / editor artefacts
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*

# CI config (not needed at runtime)
.gitlab-ci.yml

# Docs
README.md
AGENTS.md
CLAUDE.md
PROJECT_OVERVIEW.txt
CI_CD_PIPELINE_DOCUMENTATION.txt

# Local auth data
data/auth/

# Scaffold / scripts (not needed in production image)
scaffold/
scripts/
