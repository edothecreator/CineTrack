generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  username               String          @unique
  passwordHash           String
  memberSince            DateTime        @default(now())
  profileBio             String          @default("")
  profileAvatar          String?
  displayName            String?
  bannerUrl              String?
  isPublic               Boolean         @default(true)
  activities             Activity[]
  comments               Comment[]
  episodeMarks           EpisodeMark[]
  triggeredNotifications Notification[]  @relation("NotificationActor")
  notifications          Notification[]
  posts                  Post[]
  reactions              Reaction[]
  following              UserFollow[]    @relation("Follower")
  followers              UserFollow[]    @relation("Following")
  userLists              UserList[]
  watchedTitles          WatchedTitle[]
  watchlistItems         WatchlistItem[]

  @@index([email])
  @@index([username])
}

model WatchlistItem {
  id              String   @id @default(cuid())
  userId          String
  tvdbId          String
  title           String
  posterUrl       String
  rating          Float?
  releaseDate     String   @default("")
  runtimeMinutes  Int?
  heroBackdropUrl String?
  genres          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tvdbId])
  @@index([userId])
}

model WatchedTitle {
  id             String   @id @default(cuid())
  userId         String
  tvdbId         String
  title          String
  posterUrl      String
  rating         Float?
  userRating     Float?
  releaseDate    String   @default("")
  runtimeMinutes Int?
  genres         Json?
  completedAt    DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tvdbId])
  @@index([userId])
  @@index([userId, completedAt])
  @@index([userRating])
}

model EpisodeMark {
  id        String @id @default(cuid())
  userId    String
  seriesId  String
  episodeId String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId, episodeId])
  @@index([userId, seriesId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "UserFollow_follower_fkey")
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "UserFollow_following_fkey")

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Activity {
  id           String       @id @default(cuid())
  userId       String
  type         ActivityType
  tvdbId       String?
  title        String?
  posterUrl    String?
  targetUserId String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  type      NotificationType
  read      Boolean          @default(false)
  tvdbId    String?
  title     String?
  posterUrl String?
  createdAt DateTime         @default(now())
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum ActivityType {
  WATCHED
  ADDED_TO_LIST
  FOLLOWED_USER
  RATED_TITLE
}

enum NotificationType {
  NEW_FOLLOWER
  FOLLOW_BACK
  FRIEND_WATCHED
  FRIEND_ADDED_LIST
  SCENE_REACTION
  SCENE_COMMENT
  SCENE_MENTION
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  type      PostType   @default(TEXT)
  text      String?
  imageUrl  String?
  mediaType MediaType?
  tmdbId    String?
  episodeId String?
  rating    Float?
  isSpoiler Boolean    @default(false)
  takeType  TakeType?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([tmdbId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  parentId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
}

enum PostType {
  MEDIA
  TEXT
  IMAGE
}

enum MediaType {
  movie
  tv
  anime
}

enum TakeType {
  hot
  fact
  question
}

enum ReactionType {
  love
  haha
  wow
  sad
  fire
}

model UserList {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       UserListItem[]

  @@index([userId])
}

model UserListItem {
  id        String   @id @default(cuid())
  listId    String
  tmdbId    String
  title     String
  posterUrl String
  addedAt   DateTime @default(now())
  list      UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId])
  @@index([listId])
}
