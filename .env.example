# PostgreSQL (see docker-compose.yml for local)
DATABASE_URL="postgresql://cinetrack:cinetrack@localhost:5432/cinetrack?schema=public"
DIRECT_URL="postgresql://cinetrack:cinetrack@localhost:5432/cinetrack"

# JWT / session signing (use a long random string in production)
AUTH_SECRET="change_me_to_a_long_random_string"

# TMDB v4 Read Access Token — https://www.themoviedb.org/settings/api
TMDB_API_READ_TOKEN=
